# Membership enquiry delivery (app/api/interest/route.ts).
# Without these the form validates and rate-limits as normal but reports that
# the desk is not connected, rather than silently discarding the enquiry.
#
# 1. Create a key at https://resend.com/api-keys
# 2. Add all three in Vercel → Project → Settings → Environment Variables
RESEND_API_KEY=
INTEREST_TO_EMAIL=partners@example.com

# Must be a domain verified in Resend. The default sandbox sender below only
# delivers to the address that owns the Resend account.
INTEREST_FROM_EMAIL=LUXORA <onboarding@resend.dev>
